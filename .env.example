# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SIMECT. DATABASE_URL es solo para el servidor web y usa el rol SQL rocas_runtime_app.
# No uses prefijo VITE_ ni subas estas conexiones al repositorio.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Solo para ejecutar `npm run users:create` manualmente; usa rocas_provisioner_app.
# No se configura en el servicio web ni debe tener permisos de actualización/borrado.
DATABASE_PROVISION_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Origen público exacto del sitio. En Vercel no hace falta (se usa el dominio del despliegue); defínelo solo si usas un dominio propio.
APP_ORIGIN="http://localhost:3000"

# El servidor API usa 3001 durante desarrollo y 3000 en producción por defecto.
# PORT=3000

# Configura solo si el despliegue usa un proxy inverso confiable delante del servidor.
# TRUST_PROXY=1

# API de integración de SIMECT (simect.me): instituciones y estudiantes registrados.
# Solo servidor; nunca con prefijo VITE_.
SIMECT_API_URL="https://simect.me"
SIMECT_API_KEY="TU_CLAVE_X_API_KEY"

# Cloudflare R2 (audio de las entrevistas). Solo servidor.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
